generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- 核心业务表 (补全) ---

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  role      String   @default("user") // admin, user
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 反向关系定义 (Prisma 需要)
  cases     Case[]
  // templates Template[] // 如果不需要反向关系可以注释掉，或者保留
  chatMessages ChatMessage[] @relation("Sender")

  @@map("users")
}

model Template {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.Text
  icon        String?  @default("Document")
  features    Json?    // 存储 ["特性1", "特性2"]
  markData    Json?    @map("mark_data") // 存储表单结构
  filePath    String?  @map("file_path")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  cases       Case[]

  @@map("templates")
}

model Case {
  id         Int      @id @default(autoincrement())
  title      String
  templateId Int?     @map("template_id")
  userId     Int      @map("user_id")
  status     String   @default("draft") // draft, completed, archived
  formData   Json?    @map("form_data")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  template   Template? @relation(fields: [templateId], references: [id])
  user       User      @relation(fields: [userId], references: [id])

  @@map("cases")
}

model SystemLog {
  id           Int      @id @default(autoincrement())
  userId       Int?     @map("user_id")
  username     String?
  action       String
  resourceType String?  @map("resource_type")
  resourceId   Int?     @map("resource_id")
  details      Json?
  ip           String?
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("system_logs")
}

// --- 聊天相关表 ---

model ChatSession {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  adminId   Int?     @map("admin_id")
  status    String   @default("open")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chat_sessions")
}

model ChatMessage {
  id         Int      @id @default(autoincrement())
  sessionId  Int?     @map("session_id")
  senderType String   @map("sender_type")
  senderId   Int?     @map("sender_id")
  senderName String?  @map("sender_name")
  targetRoom String   @map("target_room")
  content    String   @db.Text
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  sender     User?    @relation("Sender", fields: [senderId], references: [id])

  @@map("chat_messages")
}
