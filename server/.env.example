# ============================================================
# FastReplace 后端环境变量配置示例
# 复制此文件为 .env 并填入实际值
# ============================================================

# 服务端口
PORT=5000

# MySQL 数据库配置（mysql2 连接池使用）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=fastreplace

# Prisma 数据库连接 URL（格式：mysql://用户名:密码@主机:端口/数据库名）
DATABASE_URL=mysql://root:your_password_here@localhost:3306/fastreplace

# JWT 密钥（用于用户认证，请使用随机字符串）
JWT_SECRET=your_jwt_secret_here

# Kimi AI API Key（用于 AI 智能填充功能）
KIMI_API_KEY=your_kimi_api_key_here
